---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { isDocsVersion } from "@/data/docsVersions";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const currentPathSegments = currentPath.split("/").filter(Boolean);
const isDocsPath = currentPathSegments[0] === "docs";
const explicitDocsVersion =
  isDocsPath && isDocsVersion(currentPathSegments[1] ?? "")
    ? currentPathSegments[1]
    : null;
const searchBaseHref = getRelativeLocaleUrl(locale, "search");
const searchHref = isDocsPath
  ? `${searchBaseHref}?scope=docs&version=${encodeURIComponent(explicitDocsVersion ?? "latest")}`
  : searchBaseHref;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { path: "/features", label: t.nav.features },
  { path: "/databases", label: t.nav.databases },
  { path: "/integrations", label: t.nav.integrations },
  { path: "/docs", label: t.nav.docs },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="border-border bg-background/95 sticky top-0 z-40 border-b backdrop-blur"
>
  <div class="site-shell flex items-center justify-between px-4 py-3 sm:px-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-lg font-semibold whitespace-nowrap sm:text-xl"
    >
      {site.title}
    </a>

    <nav id="nav-menu" class="flex items-center">
      <button
        id="menu-btn"
        class="focus-outline flex min-h-11 min-w-11 items-center justify-center rounded p-2 md:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <ul
        id="menu-items"
        class="bg-background border-border absolute top-full right-4 left-4 hidden max-h-[calc(100svh-5rem)] flex-col overflow-y-auto rounded-md border p-2 shadow-lg md:static md:flex md:max-h-none md:min-w-0 md:flex-row md:items-center md:gap-1 md:overflow-visible md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      >
        {
          navItems.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                class:list={[
                  "hover:text-accent flex min-h-11 items-center rounded px-3 py-2 text-base font-medium md:min-h-0 md:px-2.5 md:text-sm",
                  { "active-nav": isActive(item.path) },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="https://github.com/tse-wei-chen/hs-sql-agent"
            class="hover:text-accent flex min-h-11 items-center rounded px-3 py-2 text-base font-medium md:min-h-0 md:px-2.5 md:text-sm"
            rel="external"
          >
            {t.nav.github}
          </a>
        </li>
        {
          features.search !== false && (
            <li class="w-full md:flex md:w-auto md:items-center">
              <LinkButton
                href={searchHref}
                class:list={[
                  "focus-outline hover:bg-muted relative min-h-11 w-full justify-start rounded px-3 py-2 text-base font-medium md:size-9 md:min-h-0 md:justify-center md:p-0",
                ]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <span class="flex items-center gap-3 md:block">
                  <IconSearch class="size-5 shrink-0" />
                  <span class="md:sr-only">{t.nav.search}</span>
                </span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 hidden w-5 scale-125 md:block"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.internationalization.enabled && (
            <li class="w-full md:w-auto">
              <LocaleSwitcher />
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="w-full md:flex md:w-auto md:items-center">
              <button
                id="theme-btn"
                class="focus-outline hover:bg-muted hover:[&>span>svg]:stroke-accent flex min-h-11 w-full items-center gap-3 rounded px-3 py-2 text-base font-medium md:size-9 md:min-h-0 md:justify-center md:p-0"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
                aria-pressed="false"
              >
                <span class="relative size-5 shrink-0">
                  <IconMoon class="absolute inset-0 size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute inset-0 size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </span>
                <span class="md:sr-only">{t.a11y.toggleTheme}</span>
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const expanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", String(!expanded));
    menuBtn.setAttribute(
      "aria-label",
      expanded
        ? (menuBtn.dataset.labelOpen ?? "Open menu")
        : (menuBtn.dataset.labelClose ?? "Close menu")
    );
    menuItems.classList.toggle("hidden", expanded);
    menuItems.classList.toggle("flex", !expanded);
    menuIcon.classList.toggle("hidden", !expanded);
    closeIcon.classList.toggle("hidden", expanded);
  }

  function initHeader() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (!menuBtn || menuBtn.dataset.initialized === "true") return;
    menuBtn.dataset.initialized = "true";
    menuBtn.addEventListener("click", toggleNav);
  }

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
