---
type Props = { title: string; description?: string };
const { title, description } = Astro.props;
---

<li class="docs-step">
  <span class="docs-step-number" aria-hidden="true"></span>
  <div class="docs-step-content">
    <strong>{title}</strong>
    {description && <p>{description}</p>}
    <div class="docs-step-slot"><slot /></div>
  </div>
</li>

<style>
  .docs-step {
    counter-increment: docs-step;
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1.1rem;
    min-height: 4.6rem;
    padding-bottom: 1.25rem;
  }
  .docs-step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2.35rem;
    bottom: -.35rem;
    left: 1.34rem;
    width: 2px;
    background: linear-gradient(
      color-mix(in oklch, var(--primary) 65%, var(--border)),
      color-mix(in oklch, var(--info) 38%, var(--border)) 72%,
      transparent
    );
    box-shadow: 0 0 .8rem color-mix(in oklch, var(--primary) 22%, transparent);
  }
  .docs-step-number {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in oklch, var(--primary) 72%, var(--border));
    border-radius: 999px;
    background:
      radial-gradient(circle, color-mix(in oklch, var(--primary) 14%, var(--background)), var(--background) 70%);
    color: var(--primary);
    font: 850 .7rem/1 var(--font-google-sans-code), monospace;
    box-shadow:
      0 0 0 .3rem var(--background),
      0 0 1.25rem color-mix(in oklch, var(--primary) 28%, transparent),
      inset 0 1px color-mix(in oklch, white 10%, transparent);
  }
  .docs-step-number::after {
    position: absolute;
    inset-inline-end: -1.15rem;
    top: 50%;
    width: 1.15rem;
    height: 1px;
    background: linear-gradient(90deg, var(--primary), var(--border));
    content: "";
  }
  .docs-step-number::before { content: counter(docs-step, decimal-leading-zero); }
  .docs-step-content {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--card) 72%, transparent), transparent 70%),
      color-mix(in oklch, var(--background) 97%, var(--muted));
    padding: 1rem 1.15rem;
    box-shadow: inset 0 1px color-mix(in oklch, white 5%, transparent);
  }
  .docs-step-content::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: linear-gradient(var(--primary), var(--info), transparent 85%);
    content: "";
  }
  .docs-step-content > strong { display: block; color: var(--foreground); font-size: .92rem; }
  .docs-step-content > p { margin: .25rem 0 0; color: var(--muted-foreground); font-size: .83rem; line-height: 1.55; }
  .docs-step-slot { margin-top: .55rem; color: var(--muted-foreground); font-size: .84rem; line-height: 1.6; }
  .docs-step-slot:empty { display: none; }
  .docs-step-slot :global(p) { margin: 0; }
  .docs-step-slot :global(code) { color: var(--foreground); }
</style>
