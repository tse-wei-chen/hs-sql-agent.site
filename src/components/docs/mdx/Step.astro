---
type Props = { title: string; description?: string };
const { title, description } = Astro.props;
---

<li class="docs-step">
  <span class="docs-step-number" aria-hidden="true"></span>
  <div class="docs-step-content">
    <strong>{title}</strong>
    {description && <p>{description}</p>}
    <div class="docs-step-slot"><slot /></div>
  </div>
</li>

<style>
  .docs-step {
    counter-increment: docs-step;
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: .9rem;
    min-height: 4.6rem;
    padding-bottom: 1rem;
  }
  .docs-step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2rem;
    bottom: -.1rem;
    left: .98rem;
    width: 1px;
    background: linear-gradient(var(--border), color-mix(in oklch, var(--accent) 30%, var(--border)));
  }
  .docs-step-number {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in oklch, var(--accent) 28%, var(--border));
    border-radius: 999px;
    background: var(--background);
    color: var(--accent);
    font: 700 .72rem/1 var(--font-google-sans-code), monospace;
  }
  .docs-step-number::before { content: counter(docs-step, decimal-leading-zero); }
  .docs-step-content {
    border: 1px solid var(--border);
    border-radius: .8rem;
    background: color-mix(in oklch, var(--background) 97%, var(--muted));
    padding: .85rem 1rem;
  }
  .docs-step-content > strong { display: block; color: var(--foreground); font-size: .92rem; }
  .docs-step-content > p { margin: .25rem 0 0; color: var(--muted-foreground); font-size: .83rem; line-height: 1.55; }
  .docs-step-slot { margin-top: .55rem; color: var(--muted-foreground); font-size: .84rem; line-height: 1.6; }
  .docs-step-slot:empty { display: none; }
  .docs-step-slot :global(p) { margin: 0; }
  .docs-step-slot :global(code) { color: var(--foreground); }
</style>
