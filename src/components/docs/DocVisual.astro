---
import type { DocVisualKind } from "@/data/docsVisuals";
import { useDocsVisualUi } from "@/i18n/docsVisual";

type Props = { kind: DocVisualKind; locale: string };
const { kind, locale } = Astro.props;
const ui = useDocsVisualUi(locale);

const wideGlyphPattern =
  /[\u1100-\u11ff\u2e80-\ua4cf\uac00-\ud7af\uf900-\ufaff\ufe10-\ufe6f\uff01-\uff60\uffe0-\uffe6]/u;

function estimateSvgTextWidth(
  text: string,
  fontSize: number,
  letterSpacing = 0
) {
  const glyphs = Array.from(text);
  const width = glyphs.reduce((total, glyph) => {
    if (/\s/u.test(glyph)) return total + fontSize * 0.34;
    if (wideGlyphPattern.test(glyph)) return total + fontSize;
    if (/[A-Z0-9]/u.test(glyph)) return total + fontSize * 0.64;
    if (/[a-z]/u.test(glyph)) return total + fontSize * 0.56;
    return total + fontSize * 0.5;
  }, 0);

  return width + Math.max(0, glyphs.length - 1) * letterSpacing;
}

function fitSvgText(
  text: string,
  maxWidth: number,
  baseSize: number,
  letterSpacing = 0,
  minSize = 6.5
) {
  const estimatedWidth = estimateSvgTextWidth(text, baseSize, letterSpacing);
  if (estimatedWidth <= maxWidth) return undefined;

  const fittedSize = Math.max(
    minSize,
    baseSize * (maxWidth / estimatedWidth) * 0.96
  );

  return `font-size:${fittedSize.toFixed(2)}px`;
}
