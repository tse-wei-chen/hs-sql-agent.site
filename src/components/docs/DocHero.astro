---
import DocVisual from "./DocVisual.astro";
import { getDocSectionLabel, getDocVisualKind } from "@/data/docsVisuals";
import { useDocsUi } from "@/i18n/docs";

type Props = {
  title: string;
  description?: string;
  locale: string;
  currentSlug?: string;
};

const { title, description, locale, currentSlug = "" } = Astro.props;
const visualKind = getDocVisualKind(currentSlug);
const sectionLabel = getDocSectionLabel(currentSlug, locale);
const docsUi = useDocsUi(locale);
---

<header class:list={["doc-hero", { "doc-hero-has-visual": visualKind }]}>
  <div class="doc-hero-copy">
    <div class="doc-kicker-row">
      <span>{docsUi.kicker}</span>
      <span aria-hidden="true">/</span>
      <span>{sectionLabel}</span>
    </div>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>

  {visualKind && <DocVisual kind={visualKind} {locale} />}
</header>
