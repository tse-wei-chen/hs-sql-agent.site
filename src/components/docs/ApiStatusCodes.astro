---
import { useTranslations } from "@/i18n";

type Props = { locale?: string };
const { locale = "en" } = Astro.props;
const ui = useTranslations(locale).adminApiReference;
const codes = ["200", "201", "204", "400", "401", "403", "404", "409"] as const;
---

<table>
  <thead>
    <tr>
      <th>HTTP</th>
      <th>{ui.statusMeaning}</th>
    </tr>
  </thead>
  <tbody>
    {
      codes.map(code => (
        <tr>
          <td>
            <code>{code}</code>
          </td>
          <td>{ui.responseLabels[code]}</td>
        </tr>
      ))
    }
  </tbody>
</table>
