---
import type { CollectionEntry } from "astro:content";
import DocsVersionSwitcher from "@/components/docs/DocsVersionSwitcher.astro";
import {
  getDocGroupLabel,
  getDocUrl,
  getLocalizedSlug,
  sortDocs,
} from "@/utils/contentRouting";
import { useTranslations } from "@/i18n";
import { useDocsUi } from "@/i18n/docs";
import "@/styles/docs-mobile.css";

type Props = {
  locale: string;
  currentSlug?: string;
  docs: CollectionEntry<"docs">[];
  allDocs: CollectionEntry<"docs">[];
  docsVersion: string;
  versioned: boolean;
};

const {
  locale,
  currentSlug = "",
  docs,
  allDocs,
  docsVersion,
  versioned,
} = Astro.props;
const t = useTranslations(locale);
const docsUi = useDocsUi(locale);
const sortedDocs = sortDocs(docs, locale);
const routeVersion = versioned ? docsVersion : null;
const groups = new Map<string, CollectionEntry<"docs">[]>();

for (const doc of sortedDocs) {
  const label = getDocGroupLabel(doc);
  const groupDocs = groups.get(label) ?? [];
  groupDocs.push(doc);
  groups.set(label, groupDocs);
}
---

<div class="docs-mobile-bar lg:hidden" data-docs-mobile-nav>
  <button
    type="button"
    class="docs-mobile-trigger"
    data-docs-drawer-open
    aria-haspopup="dialog"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <span>{docsUi.navigation}</span>
  </button>
  <span class="docs-mobile-version">{docsVersion}</span>
</div>

<dialog class="docs-mobile-dialog" data-docs-drawer aria-label={t.docs.sidebarLabel}>
  <div class="docs-mobile-panel">
    <header class="docs-mobile-panel-header">
      <div>
        <span>{docsUi.kicker}</span>
        <strong>{docsVersion}</strong>
      </div>
      <button
        type="button"
        data-docs-drawer-close
        aria-label={docsUi.closeNavigation}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </header>

    <div class="docs-mobile-panel-body">
      <DocsVersionSwitcher
        {locale}
        version={docsVersion}
        {currentSlug}
        {allDocs}
      />

      <nav aria-label={t.docs.sidebarLabel}>
        {[...groups.entries()].map(([label, groupDocs]) => (
          <section class="doc-sidebar-group">
            <h2 class="doc-sidebar-title text-muted-foreground mb-2 text-xs font-semibold tracking-wider uppercase">
              {label}
            </h2>
            <ul class="space-y-1">
              {groupDocs.map(doc => {
                const slug = getLocalizedSlug(doc.id, "docs");
                const active = slug === currentSlug;
                return (
                  <li>
                    <a
                      href={getDocUrl(doc, routeVersion)}
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "doc-sidebar-link block rounded-md px-2 py-2 text-sm no-underline transition",
                        active
                          ? "bg-muted text-accent font-medium"
                          : "hover:bg-muted/70",
                      ]}
                    >
                      {doc.data.sidebar?.label ?? doc.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </nav>
    </div>
  </div>
</dialog>

<script>
  function initDocsDrawer() {
    const root = document.querySelector<HTMLElement>("[data-docs-mobile-nav]");
    const dialog = document.querySelector<HTMLDialogElement>("[data-docs-drawer]");
    const open = root?.querySelector<HTMLButtonElement>("[data-docs-drawer-open]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-docs-drawer-close]");
    if (!dialog || !open || !close || open.dataset.initialized === "true") return;

    open.dataset.initialized = "true";
    open.addEventListener("click", () => dialog.showModal());
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", event => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelectorAll<HTMLAnchorElement>("a[href]").forEach(link => {
      link.addEventListener("click", () => dialog.close());
    });
  }

  document.addEventListener("astro:page-load", initDocsDrawer);
  initDocsDrawer();
</script>
