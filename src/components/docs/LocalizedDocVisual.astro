---
import type { DocVisualKind } from "@/data/docsVisuals";
import { useDocsVisualUi } from "@/i18n/docsVisual";
import DocVisual from "./DocVisual.astro";

type Props = { kind: DocVisualKind; locale: string };
const { kind, locale } = Astro.props;
const ui = useDocsVisualUi(locale);
const viewBox = kind === "overview" ? "0 0 640 320" : "0 0 700 320";
---

<div class="doc-visual-localized-shell">
  <DocVisual {kind} locale="en" />
  <svg
    class="doc-visual-localized-labels"
    viewBox={viewBox}
    role="presentation"
    aria-hidden="true"
  >
    {
      kind === "overview" && (
        <>
          <text class="doc-svg-kicker" x="84" y="96">
            {ui.overview.gettingStarted}
          </text>
          <text class="doc-svg-label" x="84" y="122">
            {ui.overview.quickStart}
          </text>
          <text class="doc-svg-kicker" x="416" y="96">
            {ui.overview.sqlCompiler}
          </text>
          <text class="doc-svg-label" x="416" y="122">
            {ui.overview.executionModel}
          </text>
          <text class="doc-svg-kicker" x="250" y="216">
            {ui.overview.operations}
          </text>
          <text class="doc-svg-label" x="250" y="242">
            {ui.overview.deployment}
          </text>
        </>
      )
    }

    {
      kind === "compiler" && (
        <>
          <text class="doc-svg-kicker" x="48" y="60">
            {ui.compiler.pipeline}
          </text>
          {[
            [92, ui.compiler.parse],
            [220, ui.compiler.bind],
            [348, ui.compiler.validate],
            [476, ui.compiler.prove],
            [608, ui.compiler.compile],
          ].map(([x, label]) => (
            <text
              class="doc-svg-label doc-svg-label-center"
              x={x}
              y="222"
            >
              {label}
            </text>
          ))}
          <text class="doc-svg-mono" x="90" y="112">
            SELECT … FROM orders
          </text>
          <text class="doc-svg-mono" x="514" y="112">
            {ui.compiler.providerSql}
          </text>
        </>
      )
    }

    {
      kind === "safe-dml" && (
        <>
          <text class="doc-svg-kicker" x="48" y="58">
            {ui.safeDml.protocol}
          </text>
          {[
            [100, ui.safeDml.preview, "01"],
            [266, ui.safeDml.approve, "02"],
            [432, ui.safeDml.revalidate, "03"],
            [598, ui.safeDml.commit, "04"],
          ].map(([x, label, number]) => (
            <>
              <text
                class="doc-svg-kicker doc-svg-label-center"
                x={x}
                y="172"
              >
                {number}
              </text>
              <text
                class="doc-svg-label doc-svg-label-center"
                x={x}
                y="238"
              >
                {label}
              </text>
            </>
          ))}
          <text
            class="doc-svg-kicker doc-svg-label-center"
            x="266"
            y="142"
          >
            {ui.safeDml.humanApproval}
          </text>
        </>
      )
    }

    {
      kind === "mcp" && (
        <>
          <text class="doc-svg-kicker" x="48" y="58">
            {ui.mcp.protocol}
          </text>
          {[
            [118, ui.mcp.aiClient],
            [272, "MCP"],
            [428, ui.mcp.policy],
            [582, ui.mcp.database],
          ].map(([x, label]) => (
            <text
              class="doc-svg-label doc-svg-label-center"
              x={x}
              y="184"
            >
              {label}
            </text>
          ))}
          <text
            class="doc-svg-kicker doc-svg-label-center"
            x="350"
            y="278"
          >
            {ui.mcp.footer}
          </text>
        </>
      )
    }

    {
      kind === "databases" && (
        <>
          <text class="doc-svg-label doc-svg-label-center" x="350" y="156">
            SQL
          </text>
          <text class="doc-svg-kicker doc-svg-label-center" x="350" y="177">
            {ui.databases.compiler}
          </text>
          {[
            [350, 42, "PostgreSQL"],
            [520, 92, "MySQL"],
            [520, 228, "SQL Server"],
            [350, 282, "Oracle"],
            [180, 228, "SQLite"],
            [180, 92, "Firebird"],
          ].map(([x, y, label]) => (
            <text
              class="doc-svg-micro doc-svg-label-center"
              x={x}
              y={Number(y) + 4}
            >
              {label}
            </text>
          ))}
        </>
      )
    }

    {
      kind === "security" && (
        <>
          <text class="doc-svg-kicker" x="202" y="102">
            {ui.security.policyBoundary}
          </text>
          <text class="doc-svg-kicker" x="268" y="142">
            {ui.security.databaseScope}
          </text>
          <text class="doc-svg-label doc-svg-label-center" x="360" y="184">
            {ui.security.tables}
          </text>
          <text class="doc-svg-kicker doc-svg-label-center" x="107" y="158">
            MCP
          </text>
          <text class="doc-svg-label doc-svg-label-center" x="107" y="180">
            {ui.security.key}
          </text>
          <text class="doc-svg-micro doc-svg-label-center" x="229" y="171">
            {ui.security.policy}
          </text>
          <text class="doc-svg-kicker doc-svg-label-center" x="360" y="284">
            {ui.security.footer}
          </text>
        </>
      )
    }

    {
      kind === "distributed" && (
        <>
          <text class="doc-svg-kicker" x="48" y="58">
            {ui.distributed.runtime}
          </text>
          {[
            [116, 108, `${ui.distributed.node} A`],
            [116, 212, `${ui.distributed.node} B`],
            [584, 108, `${ui.distributed.node} C`],
            [584, 212, `${ui.distributed.node} D`],
          ].map(([x, y, label]) => (
            <text
              class="doc-svg-label doc-svg-label-center"
              x={x}
              y={Number(y) + 5}
            >
              {label}
            </text>
          ))}
          <text class="doc-svg-kicker doc-svg-label-center" x="350" y="106">
            POSTGRES
          </text>
          <text class="doc-svg-micro doc-svg-label-center" x="350" y="126">
            {ui.distributed.controlPlane}
          </text>
          <text class="doc-svg-kicker doc-svg-label-center" x="350" y="208">
            REDIS
          </text>
          <text class="doc-svg-micro doc-svg-label-center" x="350" y="228">
            {ui.distributed.sharedState}
          </text>
        </>
      )
    }

    {
      kind === "observability" && (
        <>
          <text class="doc-svg-kicker" x="48" y="58">
            {ui.observability.title}
          </text>
          {[
            [98, ui.observability.request],
            [148, ui.observability.auth],
            [198, ui.observability.compiler],
            [248, ui.observability.database],
          ].map(([y, label]) => (
            <text class="doc-svg-micro" x="58" y={Number(y) + 5}>
              {label}
            </text>
          ))}
          <text class="doc-svg-kicker" x="500" y="280">
            {ui.observability.footer}
          </text>
        </>
      )
    }
  </svg>
</div>

<style>
  .doc-visual-localized-shell {
    position: relative;
    margin: 0 clamp(0.8rem, 2vw, 1.5rem) clamp(0.8rem, 2vw, 1.5rem);
  }

  .doc-visual-localized-shell :global(.doc-visual) {
    margin: 0;
  }

  .doc-visual-localized-shell :global(.doc-visual text) {
    opacity: 0;
  }

  .doc-visual-localized-labels {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
