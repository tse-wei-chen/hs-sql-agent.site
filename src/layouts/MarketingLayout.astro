---
import { getRelativeLocaleUrl } from "astro:i18n";
import type {
  LocalizedMarketingPage,
  LocalizedMarketingLocale,
} from "@/data/marketingCatalog";
import { useMarketingUi } from "@/i18n/marketing";
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import "@/styles/marketing.css";

type Alternate = { locale: string; href: string };
type Props = {
  page: LocalizedMarketingPage;
  alternates?: Alternate[];
};

type DetailUi = {
  readDocs: string;
  relatedDocs: string;
  visual: Record<LocalizedMarketingPage["visual"], string[]>;
};

const detailUi: Record<LocalizedMarketingLocale, DetailUi> = {
  en: {
    readDocs: "Read technical docs",
    relatedDocs: "Related documentation",
    visual: {
      dml: ["Preview", "Approve", "Revalidate", "Commit"],
      policy: ["Scope", "Policy", "Audit", "Execute"],
      integration: ["Client", "MCP", "Policy", "SQL"],
      database: ["MCP", "Parse", "Compile", "DB"],
      compiler: ["Parse", "Validate", "Prove", "Compile"],
    },
  },
  "zh-hant": {
    readDocs: "閱讀技術文件",
    relatedDocs: "相關技術文件",
    visual: {
      dml: ["預覽", "核准", "重新驗證", "提交"],
      policy: ["範圍", "政策", "稽核", "執行"],
      integration: ["用戶端", "MCP", "政策", "SQL"],
      database: ["MCP", "解析", "編譯", "資料庫"],
      compiler: ["解析", "驗證", "證明", "編譯"],
    },
  },
  "zh-hans": {
    readDocs: "阅读技术文档",
    relatedDocs: "相关技术文档",
    visual: {
      dml: ["预览", "审批", "重新验证", "提交"],
      policy: ["范围", "策略", "审计", "执行"],
      integration: ["客户端", "MCP", "策略", "SQL"],
      database: ["MCP", "解析", "编译", "数据库"],
      compiler: ["解析", "验证", "证明", "编译"],
    },
  },
  ja: {
    readDocs: "技術ドキュメントを読む",
    relatedDocs: "関連ドキュメント",
    visual: {
      dml: ["プレビュー", "承認", "再検証", "コミット"],
      policy: ["範囲", "ポリシー", "監査", "実行"],
      integration: ["クライアント", "MCP", "ポリシー", "SQL"],
      database: ["MCP", "解析", "コンパイル", "DB"],
      compiler: ["解析", "検証", "証明", "コンパイル"],
    },
  },
  ko: {
    readDocs: "기술 문서 읽기",
    relatedDocs: "관련 기술 문서",
    visual: {
      dml: ["미리 보기", "승인", "재검증", "커밋"],
      policy: ["범위", "정책", "감사", "실행"],
      integration: ["클라이언트", "MCP", "정책", "SQL"],
      database: ["MCP", "파싱", "컴파일", "DB"],
      compiler: ["파싱", "검증", "증명", "컴파일"],
    },
  },
  fr: {
    readDocs: "Lire la documentation technique",
    relatedDocs: "Documentation associée",
    visual: {
      dml: ["Prévisualiser", "Approuver", "Revalider", "Valider"],
      policy: ["Périmètre", "Politique", "Audit", "Exécuter"],
      integration: ["Client", "MCP", "Politique", "SQL"],
      database: ["MCP", "Analyser", "Compiler", "BDD"],
      compiler: ["Analyser", "Valider", "Prouver", "Compiler"],
    },
  },
  de: {
    readDocs: "Technische Dokumentation lesen",
    relatedDocs: "Zugehörige Dokumentation",
    visual: {
      dml: ["Vorschau", "Freigabe", "Prüfen", "Commit"],
      policy: ["Scope", "Richtlinie", "Audit", "Ausführen"],
      integration: ["Client", "MCP", "Richtlinie", "SQL"],
      database: ["MCP", "Parsen", "Kompilieren", "DB"],
      compiler: ["Parsen", "Validieren", "Nachweisen", "Kompilieren"],
    },
  },
};

const { page, alternates = [] } = Astro.props;
const { locale, section } = page;
const marketingUi = useMarketingUi(locale);
const localizedDetailUi = detailUi[locale];
const urlBase = Astro.site ?? Astro.url;
const defaultAlternate =
  alternates.find(alternate => alternate.locale === config.site.lang) ??
  alternates[0];
const headline = page.headline ?? page.title;
const sectionLabel = marketingUi.sections[section][0];
const sectionUrl = getRelativeLocaleUrl(locale, section);
const visualLabels = localizedDetailUi.visual[page.visual];

const orbitCore =
  page.visual === "database"
    ? page.title.replace(" MCP Server", "")
    : page.visual === "integration"
      ? "MCP"
      : page.visual === "dml"
        ? "DML"
        : page.visual === "policy"
          ? "POLICY"
          : "SQL";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.title,
  description: page.description,
  inLanguage: locale,
  about: {
    "@type": "SoftwareApplication",
    name: config.site.title,
    applicationCategory: "DeveloperApplication",
  },
};
---

<Layout
  title={`${page.title} | ${config.site.title}`}
  description={page.description}
>
  <Fragment slot="head">
    {
      page.keywords.length > 0 && (
        <meta name="keywords" content={page.keywords.join(", ")} />
      )
    }
    {
      alternates.map(alternate => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={new URL(alternate.href, urlBase)}
        />
      ))
    }
    {
      defaultAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultAlternate.href, urlBase)}
        />
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <Header />
  <main id="main-content" class="marketing-page">
    <section class="marketing-hero">
      <div class="marketing-shell marketing-hero-grid">
        <div>
          <nav
            class="marketing-breadcrumb"
            aria-label={marketingUi.breadcrumbLabel}
          >
            <a href={getRelativeLocaleUrl(locale, "")}
              >{marketingUi.homeLabel}</a
            >
            <span aria-hidden="true">/</span>
            <a href={sectionUrl}>{sectionLabel}</a>
          </nav>
          <p class="marketing-eyebrow">{page.eyebrow}</p>
          <h1>{headline}</h1>
          <p class="marketing-lead">{page.description}</p>
          <div class="marketing-actions">
            {
              page.relatedDocs[0] && (
                <a
                  class="marketing-button marketing-button-primary"
                  href={getRelativeLocaleUrl(locale, page.relatedDocs[0].path)}
                >
                  {localizedDetailUi.readDocs} <span aria-hidden="true">→</span>
                </a>
              )
            }
            <a
              class="marketing-button"
              href="https://github.com/tse-wei-chen/hs-sql-agent"
              rel="external"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div
          class:list={["marketing-orbit", `marketing-orbit-${page.visual}`]}
          aria-hidden="true"
          data-pagefind-ignore
        >
          <div class="marketing-orbit-core">{orbitCore}</div>
          <span class="orbit-node orbit-node-a">{visualLabels[0]}</span>
          <span class="orbit-node orbit-node-b">{visualLabels[1]}</span>
          <span class="orbit-node orbit-node-c">{visualLabels[2]}</span>
          <span class="orbit-node orbit-node-d">{visualLabels[3]}</span>
        </div>
      </div>
    </section>

    {
      page.highlights.length > 0 && (
        <section
          class="marketing-shell marketing-highlights"
          aria-label={sectionLabel}
        >
          {page.highlights.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </article>
          ))}
        </section>
      )
    }

    <section class="marketing-shell marketing-content-grid">
      <article class="app-prose marketing-prose">
        <slot />
      </article>
      <aside>
        <div class="marketing-related">
          <p>{localizedDetailUi.relatedDocs}</p>
          <ul>
            {
              page.relatedDocs.map(item => (
                <li>
                  <a href={getRelativeLocaleUrl(locale, item.path)}>
                    {item.label}
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </section>
  </main>
  <Footer />
</Layout>
