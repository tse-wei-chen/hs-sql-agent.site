---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { MarketingPage } from "@/data/marketing";
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import "@/styles/marketing.css";

type Alternate = { locale: string; href: string };
type Props = {
  page: MarketingPage;
  alternates?: Alternate[];
};

const { page, alternates = [] } = Astro.props;
const { locale, section } = page;
const isZh = locale === "zh-hant";
const urlBase = Astro.site ?? Astro.url;
const defaultAlternate =
  alternates.find(alternate => alternate.locale === config.site.lang) ?? alternates[0];
const headline = page.headline ?? page.title;
const sectionLabel =
  section === "databases"
    ? isZh ? "資料庫" : "Databases"
    : section === "features"
      ? isZh ? "功能" : "Features"
      : isZh ? "整合" : "Integrations";
const sectionUrl = getRelativeLocaleUrl(locale, section);

const visualLabels =
  page.visual === "dml"
    ? ["Preview", "Approve", "Revalidate", "Commit"]
    : page.visual === "policy"
      ? ["Scope", "Policy", "Audit", "Execute"]
      : page.visual === "integration"
        ? ["Client", "MCP", "Policy", "SQL"]
        : page.visual === "database"
          ? ["MCP", "Parse", "Compile", "DB"]
          : ["Parse", "Validate", "Prove", "Compile"];

const orbitCore =
  page.visual === "database"
    ? page.title.replace(" MCP Server", "")
    : page.visual === "integration"
      ? "MCP"
      : page.visual === "dml"
        ? "DML"
        : page.visual === "policy"
          ? "POLICY"
          : "SQL";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.title,
  description: page.description,
  inLanguage: locale,
  about: {
    "@type": "SoftwareApplication",
    name: config.site.title,
    applicationCategory: "DeveloperApplication",
  },
};
---

<Layout title={`${page.title} | ${config.site.title}`} description={page.description}>
  <Fragment slot="head">
    {page.keywords.length > 0 && <meta name="keywords" content={page.keywords.join(", ")} />}
    {alternates.map(alternate => (
      <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.href, urlBase)} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, urlBase)} />
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />
  <main id="main-content" class="marketing-page">
    <section class="marketing-hero">
      <div class="marketing-shell marketing-hero-grid">
        <div>
          <nav class="marketing-breadcrumb" aria-label="Breadcrumb">
            <a href={getRelativeLocaleUrl(locale, "")}>{isZh ? "首頁" : "Home"}</a>
            <span aria-hidden="true">/</span>
            <a href={sectionUrl}>{sectionLabel}</a>
          </nav>
          <p class="marketing-eyebrow">{page.eyebrow}</p>
          <h1>{headline}</h1>
          <p class="marketing-lead">{page.description}</p>
          <div class="marketing-actions">
            {page.relatedDocs[0] && (
              <a class="marketing-button marketing-button-primary" href={getRelativeLocaleUrl(locale, page.relatedDocs[0].path)}>
                {isZh ? "閱讀技術文件" : "Read technical docs"} <span aria-hidden="true">→</span>
              </a>
            )}
            <a class="marketing-button" href="https://github.com/tse-wei-chen/hs-sql-agent" rel="external">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class:list={["marketing-orbit", `marketing-orbit-${page.visual}`]} aria-hidden="true" data-pagefind-ignore>
          <div class="marketing-orbit-core">{orbitCore}</div>
          <span class="orbit-node orbit-node-a">{visualLabels[0]}</span>
          <span class="orbit-node orbit-node-b">{visualLabels[1]}</span>
          <span class="orbit-node orbit-node-c">{visualLabels[2]}</span>
          <span class="orbit-node orbit-node-d">{visualLabels[3]}</span>
        </div>
      </div>
    </section>

    {page.highlights.length > 0 && (
      <section class="marketing-shell marketing-highlights" aria-label={isZh ? "重點" : "Highlights"}>
        {page.highlights.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </article>
        ))}
      </section>
    )}

    <section class="marketing-shell marketing-content-grid">
      <article class="app-prose marketing-prose">
        <slot />
      </article>
      <aside>
        <div class="marketing-related">
          <p>{isZh ? "相關技術文件" : "Related documentation"}</p>
          <ul>
            {page.relatedDocs.map(item => (
              <li><a href={getRelativeLocaleUrl(locale, item.path)}>{item.label}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
      </aside>
    </section>
  </main>
  <Footer />
</Layout>
