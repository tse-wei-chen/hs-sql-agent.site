---
import config from "@/config";
import { locales, localeLabels } from "@/utils/getPostsByLocale";

const supportedLocales = [...locales];
const fallbackLocale = "en";
const localeStorageKey = "preferred-locale";
const canonicalURL = new URL("/", config.site.url);
const localeLinks = locales.map(locale => ({
  locale,
  label: localeLabels[locale] ?? locale,
  href: `/${locale}/`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Choose your language | {config.site.title}</title>
    <meta
      name="description"
      content={`Choose your preferred language for ${config.site.title}.`}
    />
    <link rel="canonical" href={canonicalURL} />
    {
      localeLinks.map(item => (
        <link
          rel="alternate"
          hreflang={item.locale}
          href={new URL(item.href, config.site.url)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", config.site.url)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.site.title} />
    <meta
      property="og:title"
      content={`Choose your language | ${config.site.title}`}
    />
    <meta property="og:description" content={config.site.description} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body>
    <main>
      <section class="language-card" aria-labelledby="language-title">
        <p class="eyebrow">{config.site.title}</p>
        <h1 id="language-title">Choose your language</h1>
        <p class="description">
          Select a language below. Returning visitors are sent to their saved
          preference first, then their browser language, with English as the
          final fallback.
        </p>
        <nav class="language-grid" aria-label="Available languages">
          {
            localeLinks.map(item => (
              <a
                href={item.href}
                data-locale-choice={item.locale}
                lang={item.locale}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </section>
    </main>

    <script define:vars={{ supportedLocales, fallbackLocale, localeStorageKey }}
    >
      (() => {
        const supported = new Map(
          supportedLocales.map(locale => [locale.toLowerCase(), locale])
        );

        const normalize = value =>
          typeof value === "string"
            ? value.trim().toLowerCase().replaceAll("_", "-")
            : "";

        const resolveLocale = value => {
          const normalized = normalize(value);
          if (!normalized) return null;

          const exact = supported.get(normalized);
          if (exact) return exact;

          const [language, ...subtags] = normalized.split("-");
          if (language === "zh") {
            const tags = new Set(subtags);
            const traditional =
              tags.has("hant") ||
              tags.has("tw") ||
              tags.has("hk") ||
              tags.has("mo");
            const simplified =
              tags.has("hans") || tags.has("cn") || tags.has("sg");

            if (traditional) return supported.get("zh-hant") ?? null;
            if (simplified) return supported.get("zh-hans") ?? null;
            return null;
          }

          return supported.get(language) ?? null;
        };

        document.querySelectorAll("[data-locale-choice]").forEach(link => {
          link.addEventListener("click", () => {
            const selectedLocale = link.getAttribute("data-locale-choice");
            if (!selectedLocale) return;

            try {
              window.localStorage.setItem(localeStorageKey, selectedLocale);
            } catch {
              // localStorage can be unavailable in hardened/privacy browsing modes.
            }
          });
        });

        let selectedLocale = null;

        try {
          selectedLocale = resolveLocale(
            window.localStorage.getItem(localeStorageKey)
          );
        } catch {
          // localStorage can be unavailable in hardened/privacy browsing modes.
        }

        if (!selectedLocale) {
          const browserLocales =
            Array.isArray(navigator.languages) && navigator.languages.length > 0
              ? navigator.languages
              : [navigator.language];

          for (const browserLocale of browserLocales) {
            selectedLocale = resolveLocale(browserLocale);
            if (selectedLocale) break;
          }
        }

        window.location.replace(`/${selectedLocale ?? fallbackLocale}/`);
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: #0b0d10;
    color: #f4f4f5;
  }

  main {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 2rem;
  }

  .language-card {
    width: min(44rem, 100%);
    border: 1px solid #27272a;
    border-radius: 1rem;
    background: #111318;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .eyebrow {
    margin: 0;
    color: #a1a1aa;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.6rem 0 0;
    font-size: clamp(2rem, 8vw, 4rem);
    line-height: 1;
  }

  .description {
    max-width: 38rem;
    color: #a1a1aa;
    line-height: 1.6;
  }

  .language-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .language-grid a {
    border: 1px solid #3f3f46;
    border-radius: 0.7rem;
    padding: 0.85rem 1rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .language-grid a:hover,
  .language-grid a:focus-visible {
    border-color: #a1a1aa;
    background: #18181b;
  }
</style>
