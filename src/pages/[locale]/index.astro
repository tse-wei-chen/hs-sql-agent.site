---
import ProductHome from "@/components/ProductHome.astro";
import { locales } from "@/utils/getPostsByLocale";
import config from "@/config";

export async function getStaticPaths() {
  return locales
    .filter(locale => locale !== config.site.lang)
    .map(locale => ({ params: { locale } }));
}

const locale = Astro.currentLocale ?? config.site.lang;
---

<ProductHome locale={locale} />
