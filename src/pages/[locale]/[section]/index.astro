---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { locales } from "@/utils/getPostsByLocale";
import {
  getMarketingPages,
  hasMarketingPage,
  isMarketingSection,
  type MarketingSection,
} from "@/data/marketing";
import { getAspNetCoreMarketingPage } from "@/data/marketingAspNetCore";
import { useMarketingUi } from "@/i18n/marketing";
import config from "@/config";
import "@/styles/marketing.css";

export function getStaticPaths() {
  const sections = ["databases", "features", "integrations"] as const;
  return locales.flatMap(locale =>
    sections.map(section => ({ params: { locale, section } }))
  );
}

const locale = Astro.currentLocale ?? config.site.lang;
const sectionParam = Astro.params.section ?? "";
if (!isMarketingSection(sectionParam)) {
  throw new Error(`Unknown marketing section: ${sectionParam}`);
}
const section: MarketingSection = sectionParam;
const pages = getMarketingPages(locale, section).map(page =>
  page.section === "integrations" && page.slug === "aspnet-core"
    ? getAspNetCoreMarketingPage(locale)
    : page
);
const marketingUi = useMarketingUi(locale);
const [title, description] = marketingUi.sections[section];
const urlBase = Astro.site ?? Astro.url;
const alternates = locales.map(alternateLocale => ({
  locale: alternateLocale,
  href: getRelativeLocaleUrl(alternateLocale, section),
}));
const defaultAlternate =
  alternates.find(item => item.locale === config.site.lang) ?? alternates[0];

function getMarketingHref(pageSection: MarketingSection, slug: string): string {
  const targetLocale = hasMarketingPage(locale, pageSection, slug)
    ? locale
    : "en";
  return getRelativeLocaleUrl(targetLocale, `${pageSection}/${slug}`);
}
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Fragment slot="head">
    {
      alternates.map(alternate => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={new URL(alternate.href, urlBase)}
        />
      ))
    }
    {
      defaultAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultAlternate.href, urlBase)}
        />
      )
    }
  </Fragment>

  <Header />
  <main id="main-content" class="marketing-page">
    <section class="marketing-hero">
      <div class="marketing-shell" style="padding-block:5rem">
        <nav
          class="marketing-breadcrumb"
          aria-label={marketingUi.breadcrumbLabel}
        >
          <a href={getRelativeLocaleUrl(locale, "")}>{marketingUi.homeLabel}</a
          ><span aria-hidden="true">/</span>
        </nav>
        <p class="marketing-eyebrow">hs-sql-agent</p>
        <h1 style="max-width:15ch">{title}</h1>
        <p class="marketing-lead">{description}</p>
      </div>
    </section>
    <section class="marketing-shell" style="padding-block:4rem 7rem">
      <div
        class="border-border bg-border/30 grid gap-px border sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          pages.map(page => (
            <a
              href={getMarketingHref(page.section, page.slug)}
              class="group bg-background hover:bg-muted/40 p-6 no-underline transition"
            >
              <p class="text-primary text-xs font-bold tracking-widest uppercase">
                {page.eyebrow}
              </p>
              <h2 class="group-hover:text-primary mt-8 text-xl font-semibold tracking-tight">
                {page.title}
              </h2>
              <p class="text-muted-foreground mt-3 text-sm leading-6">
                {page.description}
              </p>
              <span class="mt-6 inline-block text-sm font-bold">
                {marketingUi.learnMore} →
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
