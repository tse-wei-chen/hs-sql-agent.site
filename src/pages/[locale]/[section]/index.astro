---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { locales } from "@/utils/getPostsByLocale";
import { getMarketingPages, isMarketingSection, type MarketingSection } from "@/data/marketing";
import config from "@/config";
import "@/styles/marketing.css";

const copy = {
  en: {
    databases: ["Database support", "Secure MCP access for PostgreSQL, MySQL, SQL Server, Oracle, SQLite, and Firebird."],
    features: ["Product capabilities", "Explore the compiler, Safe DML, and governance boundaries behind hs-sql-agent."],
    integrations: ["Integrations", "Connect MCP clients and embed hs-sql-agent into existing .NET applications."],
  },
  "zh-hant": {
    databases: ["資料庫支援", "安全連接 PostgreSQL、MySQL、SQL Server、Oracle、SQLite 與 Firebird。"],
    features: ["產品能力", "了解 hs-sql-agent 的 compiler、Safe DML 與 governance boundary。"],
    integrations: ["整合", "連接 MCP Client，或把 hs-sql-agent 嵌入既有 .NET 應用程式。"],
  },
} as const;

export function getStaticPaths() {
  const sections = ["databases", "features", "integrations"] as const;
  return locales.flatMap(locale => sections.map(section => ({ params: { locale, section } })));
}

const locale = Astro.currentLocale ?? config.site.lang;
const sectionParam = Astro.params.section ?? "";
if (!isMarketingSection(sectionParam)) {
  throw new Error(`Unknown marketing section: ${sectionParam}`);
}
const section: MarketingSection = sectionParam;
const pages = getMarketingPages(locale, section);
const langCopy = locale === "zh-hant" ? copy["zh-hant"] : copy.en;
const [title, description] = langCopy[section];
const urlBase = Astro.site ?? Astro.url;
const alternates = locales.map(alternateLocale => ({
  locale: alternateLocale,
  href: getRelativeLocaleUrl(alternateLocale, section),
}));
const defaultAlternate = alternates.find(item => item.locale === config.site.lang) ?? alternates[0];
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Fragment slot="head">
    {alternates.map(alternate => (
      <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.href, urlBase)} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, urlBase)} />}
  </Fragment>

  <Header />
  <main id="main-content" class="marketing-page">
    <section class="marketing-hero">
      <div class="marketing-shell" style="padding-block:5rem">
        <nav class="marketing-breadcrumb" aria-label="Breadcrumb"><a href={getRelativeLocaleUrl(locale, "")}>{locale === "zh-hant" ? "首頁" : "Home"}</a><span aria-hidden="true">/</span></nav>
        <p class="marketing-eyebrow">hs-sql-agent</p>
        <h1 style="max-width:15ch">{title}</h1>
        <p class="marketing-lead">{description}</p>
      </div>
    </section>
    <section class="marketing-shell" style="padding-block:4rem 7rem">
      <div class="grid gap-px border border-border bg-border/30 sm:grid-cols-2 lg:grid-cols-3">
        {pages.map(page => (
          <a href={getRelativeLocaleUrl(locale, `${page.section}/${page.slug}`)} class="group bg-background p-6 no-underline transition hover:bg-muted/40">
            <p class="text-primary text-xs font-bold tracking-widest uppercase">{page.eyebrow}</p>
            <h2 class="mt-8 text-xl font-semibold tracking-tight group-hover:text-primary">{page.title}</h2>
            <p class="text-muted-foreground mt-3 text-sm leading-6">{page.description}</p>
            <span class="mt-6 inline-block text-sm font-bold">{locale === "zh-hant" ? "了解更多" : "Learn more"} →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
