---
import { getCollection } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsIndexGroups from "@/components/docs/DocsIndexGroups.astro";
import { docsVersions } from "@/data/docsVersions";
import { locales } from "@/utils/getPostsByLocale";
import { getDocsForVersion, getDocsIndexUrl } from "@/utils/contentRouting";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  return (locales as readonly string[]).flatMap(locale =>
    docsVersions.versions.map(definition => ({
      params: { locale, version: definition.version },
      props: { locale, docsVersion: definition.version },
    }))
  );
}

const { locale, docsVersion } = Astro.props as {
  locale: string;
  docsVersion: string;
};
const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const docs = getDocsForVersion(allDocs, locale, docsVersion);
const alternateRouteVersion = docsVersion === docsVersions.current ? null : docsVersion;
const alternates = (locales as readonly string[]).map(alternateLocale => ({
  locale: alternateLocale,
  href: getDocsIndexUrl(alternateLocale, alternateRouteVersion),
}));
const t = useTranslations(locale ?? config.site.lang);
---

<DocsLayout
  title={t.docs.indexTitle}
  description={t.docs.indexDescription}
  {locale}
  {docs}
  {allDocs}
  {docsVersion}
  versioned={true}
  {alternates}
>
  <DocsIndexGroups {docs} {locale} routeVersion={docsVersion} />
</DocsLayout>
